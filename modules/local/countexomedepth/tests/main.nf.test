    // nf-core modules test countexomedepth
    nextflow_process {
    
        name "Test Process COUNTEXOMEDEPTH - cnv_hs37d5_brca1"
        script "../main.nf"
        process "COUNTEXOMEDEPTH"
    
        tag "modules"
        tag "modules_local"
        tag "countexomedepth"
        tag "cnv_hs37d5_brca1"
    
        test("cnv_hs37d5_brca1 - full test") {
    
            when {
                process {
                    """
                    // 1. [meta_cohort, bams] (tuple)
                    input[0] = [
                        [ id:'test_brca1_cnv_cohort' ],
                        [
                            "${projectDir}/tests/data/HG01516.mapped.ILLUMINA.bwa.IBS.exome.20120522_chr22_regions_CNV.bam",
                            "${projectDir}/tests/data/HG01516.mapped.ILLUMINA.bwa.IBS.exome.20120522_chr22_regions_CNV.bam.bai",
                            "${projectDir}/tests/data/HG01632.mapped.ILLUMina.bwa.IBS.exome.20121211_chr22_regions_CNV.bam",
                            "${projectDir}/tests/data/HG01632.mapped.ILLUMina.bwa.IBS.exome.20121211_chr22_regions_CNV.bam.bai",
                            "${projectDir}/tests/data/HG01702.mapped.ILLUMINA.bwa.IBS.exome.20121211_chr22_regions_CNV.bam",
                            "${projectDir}/tests/data/HG01702.mapped.ILLUMINA.bwa.IBS.exome.20121211_chr22_regions_CNV.bam.bai"
                        ]
                    ]
                    
                    // 2. bed (path)
                    input[1] = "${projectDir}/tests/data/regions.bed"
                    
                    // 3. fasta (path)
                    input[2] = "${projectDir}/tests/data/chr17.fa"
                    """
                }
            }
    
            then {
                assertAll(
                    { assert process.success },
                    // Snapshot the path of the Rdata file
                    { assert snapshot(new File(process.out.count_exomedepth_rdata.get(0).get(1)).name).match("rdata_filename") },
                    // Snapshot the versions.yml file
                    { assert snapshot(process.out.versions.get(0)).match("versions_yml") }
                )
            }
        }
    
        test("cnv_hs37d5_brca1 - stub") {
            options "-stub"
    
            when {
                process {
                    """
                    input[0] = [
                        [ id:'test_brca1_cnv_cohort' ],
                        [
                            "${projectDir}/tests/data/HG01516.mapped.ILLUMINA.bwa.IBS.exome.20120522_chr22_regions_CNV.bam",
                            "${projectDir}/tests/data/HG01516.mapped.ILLUMINA.bwa.IBS.exome.20120522_chr22_regions_CNV.bam.bai",
                            "${projectDir}/tests/data/HG01632.mapped.ILLUMina.bwa.IBS.exome.20121211_chr22_regions_CNV.bam",
                            "${projectDir}/tests/data/HG01632.mapped.ILLUMina.bwa.IBS.exome.20121211_chr22_regions_CNV.bam.bai"
                        ]
                    ]
                    input[1] = "${projectDir}/tests/data/regions.bed"
                    input[2] = "${projectDir}/tests/data/chr17.fa"
                    """
                }
            }
    
            then {
                assertAll(
                    { assert process.success },
                    // Snapshot the path of the Rdata file for stub
                    { assert snapshot(new File(process.out.count_exomedepth_rdata.get(0).get(1)).name).match("rdata_filename_stub") },
                    // Snapshot the versions.yml file for stub
                    { assert snapshot(process.out.versions.get(0)).match("versions_yml_stub") }
                )
            }
        }
    }