    // nf-core modules test countexomedepth
    nextflow_process {
    
        name "Test Process COUNTEXOMEDEPTH - cnv_hs37d5_brca1"
        script "../main.nf"
        process "COUNTEXOMEDEPTH"
    
        tag "modules"
        tag "modules_local"
        tag "countexomedepth"
        tag "cnv_hs37d5_brca1"
    
        test("cnv_hs37d5_brca1 - full test") {
    
            when {
                process {
                    """
                    input[0] = [
                        [ id:'test_brca1_cnv_cohort' ], // meta_cohort map
                        [
                            file("${projectDir}/tests/data/HG01516.mapped.ILLUMINA.bwa.IBS.exome.20120522_chr22_regions_CNV.bam", checkIfExists: true),
                            file("${projectDir}/tests/data/HG01632.mapped.ILLUMINA.bwa.IBS.exome.20121211_chr22_regions_CNV.bam", checkIfExists: true)
                            // Add more BAM files from your tests/data directory if needed
                        ], // bams list
                        file("${projectDir}/tests/data/regions.bed", checkIfExists: true), // bed_file
                        file("${projectDir}/tests/data/chr17.fa", checkIfExists: true)      // fasta_file
                    ]
                    """
                }
            }
    
            then {
                assertAll(
                    { assert process.success },
                    // Snapshot the path of the Rdata file
                    { assert snapshot(process.out.rdata.get(0).get(1).name).match("rdata_filename") },
                    // Snapshot the versions.yml file
                    { assert snapshot(process.out.versions.get(0)).match("versions_yml") }
                )
            }
        }
    
        test("cnv_hs37d5_brca1 - stub") {
            options "-stub"
    
            when {
                process {
                    """
                    input[0] = [
                        [ id:'test_brca1_cnv_cohort_stub' ], // meta_cohort map
                        [
                            file("${projectDir}/tests/data/HG01516.mapped.ILLUMINA.bwa.IBS.exome.20120522_chr22_regions_CNV.bam", checkIfExists: true),
                            file("${projectDir}/tests/data/HG01632.mapped.ILLUMINA.bwa.IBS.exome.20121211_chr22_regions_CNV.bam", checkIfExists: true)
                        ], // bams list
                        file("${projectDir}/tests/data/regions.bed", checkIfExists: true), // bed_file
                        file("${projectDir}/tests/data/chr17.fa", checkIfExists: true)      // fasta_file
                    ]
                    """
                }
            }
    
            then {
                assertAll(
                    { assert process.success },
                    // Snapshot the path of the Rdata file for stub
                    { assert snapshot(process.out.rdata.get(0).get(1).name).match("rdata_filename_stub") },
                    // Snapshot the versions.yml file for stub
                    { assert snapshot(process.out.versions.get(0)).match("versions_yml_stub") }
                )
            }
        }
    }